{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VaultFlow",
  "version": "0.1.0",
  "identifier": "com.vaultflow.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VaultFlow",
        "width": 1150,
        "height": 760,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://github.com https://api.github.com https://accounts.google.com https://oauth2.googleapis.com"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["vaultflow"],
          "host": "oauth"
        }
      ],
      "desktop": {
        "schemes": ["vaultflow"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
